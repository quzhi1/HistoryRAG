DATABASE_URL=postgres://postgres:postgres@localhost:5432/{DB_NAME}

# Set to "yes" to use local model, "no" to use OpenAI (requires OPENAI_API_KEY)
USE_LOCAL_MODEL=yes

# OpenAI API Key (required if USE_LOCAL_MODEL is "no")
OPENAI_API_KEY=...

# Local Model Configuration (e.g., Ollama, LM Studio, vLLM)
# Default is Ollama's base URL
LOCAL_MODEL_BASE_URL=http://localhost:11434/v1

# Chat model name (e.g., qwen2.5:7b, llama3.1:8b, mistral:7b)
LOCAL_CHAT_MODEL=qwen3:8b

# Embedding model name (e.g., nomic-embed-text, mxbai-embed-large)
LOCAL_EMBEDDING_MODEL=qwen3-embedding

# Embedding dimensions (768 for nomic-embed-text, 1536 for OpenAI, etc.)
# Note: pgvector HNSW index is limited to 2000 dimensions, use IVFFlat for higher dimensions
EMBEDDING_DIMENSIONS=768